# Copy to .env and fill in. NEVER commit .env. NEVER paste these values in chat.
# The deployer key is read from the environment only (see hardhat.config.js).

# Private key of the deployer account (0x-prefixed hex). Used ONLY by
# scripts/deploy.js on testnet/mainnet. Leave empty for local testing.
DEPLOYER_PRIVATE_KEY=

# Official Agent ID contract (default is the verified mainnet address).
# AGENT_ID_ADDRESS=0x60b9262456de011f7d15a54cdd8c48baaa8b022f

# Mainnet deploy guard: deploy to chain 56 refuses unless this is "yes".
# CONFIRM_MAINNET_DEPLOY=no

# Optional genesis collection at deploy time (deployer must hold an Agent ID).
# CREATE_GENESIS=false
# GENESIS_NAME=AgentMint Genesis
# GENESIS_SYMBOL=AMG
# GENESIS_MAX_SUPPLY=10000
# GENESIS_BASE_URI=
# GENESIS_PAYOUT_PER_MINT=1000
